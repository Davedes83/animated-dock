#!/bin/bash
#
# Configurator for the animated.dock shell plugin.
#
# Everything it writes lands in the plugin's entry in shell.json, which the
# Omarchy shell re-reads on save — so most changes here show up on the dock
# immediately. The exceptions: ensure-bar patches a *user-owned* taskbar
# clone's Bar.qml, and installing that support once needs a shell restart
# (done automatically the first time a sync setting is used).
#
# The dock drives shell.json through the non-interactive subcommands
# (pin / unpin / move) rather than writing QML-side, so the staged-tempfile
# validation below stays the *only* writer. Indices are 0-based, matching
# items[] as the plugin reads it.

set -uo pipefail

CFG="$HOME/.config/omarchy/shell.json"
DOCK='(.plugins[] | select(.id=="animated.dock"))'

# ----------------------------------------------------------------- plumbing

die() {
  echo "error: $1" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."
}

# Write a mutated config atomically, but only if the result is still valid
# JSON that keeps the dock entry intact. A broken shell.json costs you the
# whole bar, not just the dock. Extra arguments are passed to jq, for
# callers that need --arg/--argjson bindings in the expression.
apply() {
  local expr=$1 tmp
  shift
  tmp=$(mktemp "$CFG.XXXXXX") || return 1

  if ! jq "$@" "$DOCK |= ($expr)" "$CFG" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    echo "error: update failed — nothing changed." >&2
    return 1
  fi

  if ! jq -e "$DOCK | .id" "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "error: update would have dropped the dock entry — nothing changed." >&2
    return 1
  fi

  cp "$CFG" "$CFG.bak"
  mv "$tmp" "$CFG"
}

item_count() { jq -r "$DOCK | .items | length" "$CFG" 2>/dev/null; }

item_label() {
  jq -r "$DOCK.items[$1] |
    if .spacer == true then \"── divider ──\"
    else ((.label // .desktop // .exec // \"(unnamed)\") +
         (if .when then \" (when)\" else \"\" end))
    end" "$CFG" 2>/dev/null
}

valid_index() {
  local idx=$1 count
  [[ $idx =~ ^[0-9]+$ ]] || return 1
  count=$(item_count)
  [[ $idx -lt ${count:-0} ]]
}

# -------------------------------------------------- programmatic subcommands

# Resolve an appId to a desktop entry id the way the plugin matches windows,
# roughly in reverse: exact basename, then case-insensitive basename or
# reverse-DNS tail, then StartupWMClass.
find_entry_for_appid() {
  local appid=$1 dir file id
  local tail=${appid##*.}
  local dirs=("$HOME/.local/share/applications" /usr/share/applications)

  for dir in "${dirs[@]}"; do
    [[ -f "$dir/$appid.desktop" ]] && { echo "$appid"; return 0; }
  done

  local lc_appid=${appid,,} lc_tail=${tail,,}
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    for file in "$dir"/*.desktop; do
      [[ -e $file ]] || continue
      id=$(basename "$file" .desktop)
      local lc_id=${id,,}
      if [[ $lc_id == "$lc_appid" || $lc_id == "$lc_tail" || ${lc_id##*.} == "$lc_appid" ]]; then
        echo "$id"; return 0
      fi
    done
  done

  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    file=$(grep -ilE "^StartupWMClass=${appid}$" "$dir"/*.desktop 2>/dev/null | head -1)
    [[ -n $file ]] && { basename "$file" .desktop; return 0; }
  done

  return 1
}

cmd_pin() {
  local appid=$1 pos=${2:-}
  [[ -n $appid ]] || die "usage: omarchy-dock-config pin <appId> [index]"
  if [[ -n $pos && ! $pos =~ ^[0-9]+$ ]]; then
    die "pin: index must be a non-negative integer"
  fi

  # Belt and braces — the dock only offers Pin on unclaimed apps, but the
  # CLI can be called by hand.
  if jq -e --arg k "${appid,,}" "$DOCK | any(.items[]?;
        ([.appId // empty] | flatten | map(ascii_downcase) | index(\$k) != null)
        or ((.desktop // empty | ascii_downcase | sub(\"\\\\.desktop$\"; \"\")) == \$k))" \
      "$CFG" >/dev/null 2>&1; then
    echo "already pinned: $appid"
    return 0
  fi

  local item entry
  if entry=$(find_entry_for_appid "$appid"); then
    item=$(jq -cn --arg d "$entry" '{desktop: $d}')
  else
    # No desktop entry to launch by — pin as a match-only item; the user
    # can set an exec later.
    item=$(jq -cn --arg a "$appid" '{appId: $a, label: $a}')
  fi

  if [[ -n $pos ]]; then
    local count
    count=$(item_count)
    [[ $pos -gt ${count:-0} ]] && pos=$count
    apply '.items |= (.[:$p] + [$item] + .[$p:])' \
      --argjson item "$item" --argjson p "$pos" || exit 1
    echo "pinned at $pos: $appid -> $item"
  else
    apply '.items += [$item]' --argjson item "$item" || exit 1
    echo "pinned: $appid -> $item"
  fi
}

cmd_unpin() {
  local idx=$1
  valid_index "$idx" || die "usage: omarchy-dock-config unpin <index> (0-based, have $(item_count) items)"
  local label
  label=$(item_label "$idx")
  apply "del(.items[$idx])" || exit 1
  echo "unpinned [$idx]: $label"
}

cmd_move() {
  local from=$1 to=$2
  valid_index "$from" || die "usage: omarchy-dock-config move <from> <to> (0-based)"
  [[ $to =~ ^[0-9]+$ ]] || die "usage: omarchy-dock-config move <from> <to> (0-based)"
  local count
  count=$(item_count)
  [[ $to -lt $count ]] || to=$((count - 1))
  apply ".items |= (.[$from] as \$x | del(.[$from]) | .[:$to] + [\$x] + .[$to:])" || exit 1
  echo "moved: $from -> $to"
}

cmd_set_item() {
  local idx=$1 json=$2
  valid_index "$idx" || die "usage: omarchy-dock-config set-item <index> <json> (0-based)"
  echo "$json" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "set-item: not a JSON object: $json"
  apply ".items[$idx] = \$item" --argjson item "$(echo "$json" | jq -c .)" || exit 1
  echo "set [$idx]: $(echo "$json" | jq -c .)"
}

cmd_add() {
  local json=$1 pos=${2:-}
  echo "$json" | jq -e 'type == "object"' >/dev/null 2>&1 \
    || die "add: not a JSON object: $json"
  local item count
  item=$(echo "$json" | jq -c .)
  if [[ -n $pos ]]; then
    [[ $pos =~ ^[0-9]+$ ]] || die "add: index must be a non-negative integer"
    count=$(item_count)
    [[ $pos -gt ${count:-0} ]] && pos=$count
    apply '.items |= (.[:$p] + [$item] + .[$p:])' \
      --argjson item "$item" --argjson p "$pos" || exit 1
  else
    apply '.items += [$item]' --argjson item "$item" || exit 1
  fi
  echo "added: $item"
}

# Dock-level settings. Value is JSON, so numbers, bools and strings all
# come through typed; "null" deletes the key so the built-in default rules
# again.
cmd_set() {
  local key=$1 value=$2
  [[ $key =~ ^[a-zA-Z][a-zA-Z0-9]*$ ]] || die "usage: omarchy-dock-config set <key> <json-value>"
  [[ $key == "id" || $key == "items" ]] && die "set: '$key' is not a settable key"
  # Valid JSON only. jq -e: 0 truthy, 1 valid-but-falsey (false/null), and
  # >=2 means a parse/compile error. So rc that high = not JSON output.
  local rc
  echo "$value" | jq -e '.' >/dev/null 2>&1
  rc=$?
  [[ $rc -ge 2 ]] && die "set: not valid JSON: $value"
  if [[ $(echo "$value" | jq -c .) == "null" ]]; then
    apply "del(.$key)" || exit 1
    echo "unset: $key"
  else
    apply ".$key = \$v" --argjson v "$(echo "$value" | jq -c .)" || exit 1
    echo "set: $key = $(echo "$value" | jq -c .)"
  fi
}

cmd_state() {
  require jq
  [[ -f $CFG ]] || die "No shell.json at $CFG"
  jq -r "$DOCK" "$CFG" 2>/dev/null \
    || die "no entry for animated.dock in $CFG (the plugin is not enabled)"
}

# Apply a full-document jq filter with the same atomic-write and validity
# checks as apply(). Unlike apply(), it is not scoped to the dock entry:
# it may touch `.bar` and the dock entry together in one atomic write (one
# shell reload, not two). The dock entry must survive whatever it does.
apply_bar() {
  local expr=$1 tmp
  shift
  tmp=$(mktemp "$CFG.XXXXXX") || return 1

  if ! jq "$@" "$expr" "$CFG" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    echo "error: bar update failed — nothing changed." >&2
    return 1
  fi

  # A jq expression like `a, b` streams multiple documents; shell.json must
  # stay a single JSON object, so refuse anything that emits more than one.
  if ! jq -se 'length == 1' "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "error: bar update produced multiple documents — nothing changed." >&2
    return 1
  fi

  if ! jq -e "$DOCK | .id" "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "error: update would have broken shell.json — nothing changed." >&2
    return 1
  fi

  cp "$CFG" "$CFG.bak"
  mv "$tmp" "$CFG"
}

# -------------------------------------------------------------- bar installer

# The dock's taskbar-sync settings ("Sync taskbar opacity" / "Sync taskbar
# corners") write bar.backgroundOpacity and bar.cornerShape/bar.cornerRadius
# to shell.json, but only a taskbar that reads those reacts. Stock omarchy.bar
# ignores them, so making support automatic means: ensure_bar_supported()
# makes the *active* taskbar support them, once, idempotently —
#   - nothing to do if the active bar already understands both (has the
#     setBackgroundOpacity() and setBarCorners() functions);
#   - otherwise it clones the stock bar (or re-activates the user's existing
#     clone) exactly like `omarchy plugin clone`, then patches the user-owned
#     Bar.qml with the anchored edits below (per-feature; an older patched bar
#     just backfills the missing piece).
# Any on-disk change sets BAR_INSTALLED=1 so the caller can restart the shell
# once: the freshly patched bar only loads on restart.

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
OMARCHY_BIN="${OMARCHY_BIN:-omarchy}"
BAR_INSTALLED=0

# Add backgroundOpacity and corner-shape support to a copied (user-owned)
# bar's Bar.qml. Anchored on exact stock lines, each of which must appear
# exactly once, or we refuse to touch the file: a differently-shaped future
# bar should fail loudly here rather than corrupt the user's own copy.
# Per-feature and idempotent — each edit is skipped when its guard marker
# function is already present, so an older patched bar just backfills the
# missing piece. Writes a .bak and re-checks the file before replacing it.
patch_bar() {
  local qml=$1
  python3 - "$qml" <<'PY' >/dev/null || die "could not patch $qml — see the python3 error above"
import shutil, sys

p = sys.argv[1]
src = open(p, encoding="utf-8").read()

def patched(marker):
    return marker in src

wants_opacity = not patched("function setBackgroundOpacity")
wants_corners = not patched("function setBarCorners")

if not (wants_opacity or wants_corners):
    sys.exit(0)  # fully supported already

prop_anchor = "  property bool transparent: false"
call_anchor = "    setRequestedTransparency(config.transparent === true)"
fn_anchor = "  function restoreForegroundAnimation()"
color_anchor = 'color: root.transparent ? "transparent" : root.background'
color_next = "    surfaceFormat.opaque: false"
color_pair = color_anchor + "\n" + color_next


def once(anchor, label):
    n = src.count(anchor)
    if n != 1:
        print(f"patch_bar: {label} anchor not found exactly once (count={n}) —"
              " this bar version is not supported", file=sys.stderr)
        sys.exit(1)


if wants_opacity:
    once(prop_anchor, "transparent-property")
    once(call_anchor, "setRequestedTransparency-call")
    once(fn_anchor, "restoreForegroundAnimation-function")
    if src.count(color_pair) != 1:
        print("patch_bar: main taskbar background line not found exactly once —"
              " this bar version is not supported", file=sys.stderr)
        sys.exit(1)

    prop = ("\n"
            "  // Bar background translucency, driven by `bar.backgroundOpacity` in\n"
            "  // shell.json (0\u20131, or a percentage above 1). Missing/invalid = 1.0\n"
            "  // (the normal opaque bar). The dock's \"Sync taskbar opacity\" setting\n"
            "  // writes this key. Independent of `transparent`, which hard-overrides\n"
            "  // the surface to fully transparent.\n"
            "  property real backgroundOpacity: 1.0")
    i = src.index(prop_anchor) + len(prop_anchor)
    src = src[:i] + prop + src[i:]

    j = src.index(call_anchor) + len(call_anchor)
    src = src[:j] + "\n    root.setBackgroundOpacity(config.backgroundOpacity)" + src[j:]

    fn = ("  function setBackgroundOpacity(value) {\n"
          "    var n = Number(value)\n"
          "    if (!isFinite(n) || n < 0) {\n"
          "      root.backgroundOpacity = 1.0\n"
          "      return\n"
          "    }\n"
          "    if (n > 1) n = n / 100\n"
          "    root.backgroundOpacity = Math.min(1, n)\n"
          "  }\n\n")
    k = src.index(fn_anchor)
    src = src[:k] + fn + src[k:]

    src = src.replace(
        color_pair,
        'color: root.transparent ? "transparent" : Util.alpha(root.background, root.backgroundOpacity)\n'
        + color_next,
        1,
    )

# Corner anchors refer to content introduced by the opacity edits above, so
# they are verified (and applied) *after* those edits land.
if wants_corners:
    once("  property real backgroundOpacity: 1.0", "backgroundOpacity-property")
    once("    root.setBackgroundOpacity(config.backgroundOpacity)", "setBackgroundOpacity-call")
    once(fn_anchor, "restoreForegroundAnimation-function")
    once("    color: root.transparent ? \"transparent\" : Util.alpha(root.background, root.backgroundOpacity)\n"
         + "    surfaceFormat.opaque: false", "alpha-background-line")

    corner_prop = ("\n"
                   "  // Taskbar corner rounding, driven by `bar.cornerShape` and\n"
                   "  // `bar.cornerRadius` in shell.json (radius in theme spaces,\n"
                   "  // like the dock's cornerRadius). Missing shape = plain\n"
                   "  // rectangle. The dock's \"Sync taskbar corners\" setting writes\n"
                   "  // these keys.\n"
                   "  property real barCornerRadius: 0")
    i = src.index("  property real backgroundOpacity: 1.0") + len("  property real backgroundOpacity: 1.0")
    src = src[:i] + corner_prop + src[i:]

    j = src.index("    root.setBackgroundOpacity(config.backgroundOpacity)") \
        + len("    root.setBackgroundOpacity(config.backgroundOpacity)")
    src = src[:j] + "\n    root.setBarCorners(config.cornerShape, config.cornerRadius)" + src[j:]

    fn = ("  function setBarCorners(shape, radius) {\n"
          "    var s = String(shape || \"\").toLowerCase()\n"
          "    if (s !== \"square\" && s !== \"pill\" && s !== \"rounded\") {\n"
          "      root.barCornerRadius = 0\n"
          "      return\n"
          "    }\n"
          "    if (s === \"square\") {\n"
          "      root.barCornerRadius = 0\n"
          "    } else if (s === \"pill\") {\n"
          "      root.barCornerRadius = Math.max(1, Math.round(root.barSize / 2))\n"
          "    } else {\n"
          "      root.barCornerRadius = Number(radius) > 0 ? Style.space(Number(radius)) : Style.cornerRadius\n"
          "    }\n"
          "  }\n\n")
    k = src.index(fn_anchor)
    src = src[:k] + fn + src[k:]

    src = src.replace(
        "    color: root.transparent ? \"transparent\" : Util.alpha(root.background, root.backgroundOpacity)\n"
        + "    surfaceFormat.opaque: false",
        "    color: \"transparent\"\n"
        "    surfaceFormat.opaque: false\n"
        "\n"
        "    // The surface is transparent; this shape paints the real background so\n"
        "    // it can be rounded. Same color/opacity expression as the old window\n"
        "    // color, radius from setBarCorners() (0 keeps the plain rectangle).\n"
        "    Rectangle {\n"
        "      id: barBackgroundSurface\n"
        "      anchors.fill: parent\n"
        "      color: root.transparent ? \"transparent\" : Util.alpha(root.background, root.backgroundOpacity)\n"
        "      radius: root.barCornerRadius\n"
        "    }\n",
        1,
    )

if src.count("{") != src.count("}"):
    print("patch_bar: brace balance broken after edit", file=sys.stderr)
    sys.exit(1)

shutil.copy2(p, p + ".bak")
open(p, "w", encoding="utf-8").write(src)
PY
  grep -q 'function setBackgroundOpacity' "$qml" \
    && grep -q 'function setBarCorners' "$qml" \
    || die "could not patch $qml — the edits did not land"
}

ensure_bar_supported() {
  local bar_id dir clone_id
  BAR_INSTALLED=0
  bar_id=$(jq -r '.bar.id // "omarchy.bar"' "$CFG" 2>/dev/null)

  # Stock bar -> clone it into plugins/<user>.bar and switch to it. Bringing
  # the shipped CLI in keeps names, manifests and activation canonical.
  if [[ $bar_id == "omarchy.bar" ]]; then
    clone_id="${USER:-$(id -un)}.bar"
    if [[ -d $PLUGINS_DIR/$clone_id ]]; then
      require omarchy-shell
      omarchy-shell shell enablePlugin "$clone_id" "" >/dev/null 2>&1 \
        || die "could not activate the cloned taskbar '$clone_id'"
    else
      require "$OMARCHY_BIN"
      "$OMARCHY_BIN" plugin clone omarchy.bar >/dev/null 2>&1 \
        || die "could not clone the taskbar; run manually: omarchy plugin clone omarchy.bar"
    fi
    bar_id=$clone_id
    BAR_INSTALLED=1
  fi

  dir="$PLUGINS_DIR/$bar_id"
  [[ -f $dir/Bar.qml ]] || die "taskbar '$bar_id' has no Bar.qml at $dir"

  grep -q 'function setBackgroundOpacity' "$dir/Bar.qml" \
    && grep -q 'function setBarCorners' "$dir/Bar.qml" && return 0
  patch_bar "$dir/Bar.qml"
  BAR_INSTALLED=1
}

# The shell.json write (apply_bar, above) happens *before* any restart, so a
# single restart picks up the patched bar and the setting at the same time.
restart_shell_after_install() {
  local title=${2:-Sync taskbar setting}
  require "$OMARCHY_BIN"
  omarchy-notification-send -g "󰍝" "$title" "$1" >/dev/null 2>&1 || true
  "$OMARCHY_BIN" restart shell >/dev/null 2>&1 || true
}

# Toggle "Sync taskbar opacity": on -> the taskbar background opacity tracks
# the dock's own backgroundOpacity (written as bar.backgroundOpacity in
# shell.json); off -> the taskbar returns to its normal opaque background.
cmd_matchbar_opacity() {
  local on=$1 current
  [[ $on == "true" || $on == "false" ]] \
    || die "usage: omarchy-dock-config matchbar-opacity <true|false>"

  ensure_bar_supported

  current=$(jq -r "$DOCK.backgroundOpacity // 1.0" "$CFG" 2>/dev/null)
  if [[ -z $current || $current == "null" ]]; then current=1.0; fi

  if [[ $on == "true" ]]; then
    apply_bar \
      '(.bar.backgroundOpacity = $o) | (.plugins[] | select(.id=="animated.dock")).matchBarOpacity = true' \
      --argjson o "$current" \
      || exit 1
    if (( BAR_INSTALLED )); then
      restart_shell_after_install "Taskbar opacity support installed — restarting to apply it." "Sync taskbar opacity"
    fi
    echo "matchbar-opacity: on (bar.backgroundOpacity = $current)"
  else
    apply_bar \
      'del(.bar.backgroundOpacity) | del((.plugins[] | select(.id=="animated.dock")).matchBarOpacity)' \
      || exit 1
    if (( BAR_INSTALLED )); then
      restart_shell_after_install "Taskbar opacity support installed — restarting to apply it." "Sync taskbar opacity"
    fi
    echo "matchbar-opacity: off (taskbar returns to its normal opacity)"
  fi
}

# Set just the taskbar's background opacity. Used while the sync toggle is on
# and the dock's background-opacity slider moves. Accepts a fraction (0.35)
# or a percentage (40); the bar turns percentages into fractions.
cmd_bar_opacity() {
  local value=$1
  [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] \
    || die "usage: omarchy-dock-config bar-opacity <fraction-or-percent>"

  ensure_bar_supported
  apply_bar '(.bar.backgroundOpacity = $o)' --argjson o "$value" || exit 1
  if (( BAR_INSTALLED )); then
    restart_shell_after_install "Taskbar opacity support installed — restarting to apply it." "Sync taskbar opacity"
  fi
  echo "bar-opacity: $value"
}

# Toggle "Sync taskbar corners": on -> the taskbar's background is given the
# same corner shape as the dock (bar.cornerShape: square / pill / rounded,
# plus bar.cornerRadius when the dock has an explicit rounded radius);
# off -> the taskbar returns to its plain rectangular background.
cmd_matchbar_corners() {
  local on=$1
  [[ $on == "true" || $on == "false" ]] \
    || die "usage: omarchy-dock-config matchbar-corners <true|false>"

  ensure_bar_supported

  if [[ $on == "true" ]]; then
    local shape radius radius_js
    shape=$(jq -r "$DOCK.cornerShape // \"rounded\"" "$CFG" 2>/dev/null)
    case "$shape" in square|pill|rounded) ;; *) shape="rounded" ;; esac
    radius=$(jq -r "$DOCK.cornerRadius // null" "$CFG" 2>/dev/null)
    if [[ $shape == "rounded" && $radius =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      radius_js=$radius
    else
      radius_js=null
    fi
    apply_bar \
      '(.bar.cornerShape = $shape) | if ($radius != null) then (.bar.cornerRadius = $radius) else del(.bar.cornerRadius) end | (.plugins[] | select(.id=="animated.dock")).matchBarCorners = true' \
      --arg shape "$shape" --argjson radius "$radius_js" \
      || exit 1
    if (( BAR_INSTALLED )); then
      restart_shell_after_install "Taskbar corner support installed — restarting to apply it." "Sync taskbar corners"
    fi
    if [[ $radius_js == "null" ]]; then
      echo "matchbar-corners: on (bar.cornerShape = $shape)"
    else
      echo "matchbar-corners: on (bar.cornerShape = $shape, bar.cornerRadius = $radius_js)"
    fi
  else
    apply_bar \
      'del(.bar.cornerShape) | del(.bar.cornerRadius) | del((.plugins[] | select(.id=="animated.dock")).matchBarCorners)' \
      || exit 1
    if (( BAR_INSTALLED )); then
      restart_shell_after_install "Taskbar corner support installed — restarting to apply it." "Sync taskbar corners"
    fi
    echo "matchbar-corners: off (taskbar returns to its rectangular background)"
  fi
}

# Re-mirror the dock's current corner shape onto the taskbar right now. The
# settings UI triggers this when the Corner Shape picker changes, so the
# taskbar follows the dock live while the sync toggle is on.
cmd_bar_corner() {
  ensure_bar_supported
  local shape radius radius_js
  shape=$(jq -r "$DOCK.cornerShape // \"rounded\"" "$CFG" 2>/dev/null)
  case "$shape" in square|pill|rounded) ;; *) shape="rounded" ;; esac
  radius=$(jq -r "$DOCK.cornerRadius // null" "$CFG" 2>/dev/null)
  if [[ $shape == "rounded" && $radius =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    radius_js=$radius
  else
    radius_js=null
  fi
  apply_bar \
    '(.bar.cornerShape = $shape) | if ($radius != null) then (.bar.cornerRadius = $radius) else del(.bar.cornerRadius) end' \
    --arg shape "$shape" --argjson radius "$radius_js" \
    || exit 1
  if (( BAR_INSTALLED )); then
    restart_shell_after_install "Taskbar corner support installed — restarting to apply it." "Sync taskbar corners"
  fi
  if [[ $radius_js == "null" ]]; then
    echo "bar-corner: shape=$shape (no explicit dock radius)"
  else
    echo "bar-corner: shape=$shape, radius=$radius_js"
  fi
}

# Make sure the active taskbar understands bar.backgroundOpacity and restart
# when it was just enabled. Idempotent; touches nothing when support is there.
cmd_ensure_bar() {
  ensure_bar_supported
  local bar_id
  bar_id=$(jq -r '.bar.id // "omarchy.bar"' "$CFG")
  if (( BAR_INSTALLED )); then
    restart_shell_after_install "Taskbar sync support was just installed for '$bar_id'."
  else
    echo "ensure-bar: taskbar '$bar_id' already supports backgroundOpacity and corners — nothing to do."
  fi
}

if [[ $# -gt 0 ]]; then
  case $1 in
    pin)      require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_pin "${1:-}" "${2:-}" ;;
    unpin)    require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_unpin "${1:-}" ;;
    move)     require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_move "${1:-}" "${2:-}" ;;
    set-item) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_set_item "${1:-}" "${2:-}" ;;
    add)      require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_add "${1:-}" "${2:-}" ;;
    set)      require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_set "${1:-}" "${2:-}" ;;
    bar-opacity) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_bar_opacity "${1:-}" ;;
    matchbar-opacity) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_matchbar_opacity "${1:-}" ;;
    bar-corner) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_bar_corner ;;
    matchbar-corners) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; shift; cmd_matchbar_corners "${1:-}" ;;
    ensure-bar) require jq; [[ -f $CFG ]] || die "No shell.json at $CFG"; cmd_ensure_bar ;;
    state)    cmd_state ;;
    -h | --help | help)
      cat <<'EOF'
animated.dock configurator

The plugin's own entry in ~/.config/omarchy/shell.json is the only config
surface. These subcommands edit it atomically (backup at shell.json.bak),
and the shell hot-reloads the change on save.

  pin <appId> [index]    pin a running app's id (0-based items[] order)
  unpin <index>          remove a pinned item
  move <from> <to>       reorder a pinned item (0-based)
  set-item <index> <json>  replace a pinned item wholesale
  add <json> [index]     append (or insert) a raw item object
  set <key> <json>       set a dock-level setting; "null" deletes a key
  bar-opacity <fraction-or-percent>  set the taskbar's background opacity
  matchbar-opacity <true|false>  sync the taskbar's opacity with the dock's
  bar-corner                 re-mirror the dock's corner shape onto the taskbar
  matchbar-corners <true|false>  sync the taskbar's corners with the dock's
  ensure-bar                 install taskbar sync support (idempotent)
  state                  print the plugin's entry

The first time any sync setting runs, ensure-bar installs the small taskbar
support the dock needs (backgroundOpacity + corner shape) and restarts the
shell once; after that all these commands are instant. The bar's Bar.qml is
only touched when it is an unsupported user-owned copy (stock omarchy.bar is
first cloned into your plugins, exactly like `omarchy plugin clone`).

Keys the dock reads from its entry: edge, align, iconSize, zoom, zoomRaise,
magnify, animation, spacing, padding, backgroundOpacity, glyphScale,
tiles, tileRadius, tileInset, tileOpacity, border, borderOpacity, cornerRadius,
cornerShape, autohide, dodge, pressure, revealDelay, hideDelay, showWhenEmpty, hotspotHeight,
hotspotFullWidth, runningIndicator, labels, showRunning, tintIcons,
tintRunning, monochrome, glyphColor, matchBarOpacity, matchBarCorners, fullWidth, edgeGap, items.

Item forms in items[]:
  { "desktop": "kitty" }                  launch a desktop entry
  { "exec": "cmd", "icon": "...", "label": "..." }  run any command
  { "exec": "cmd", "glyph": "NICON" }     a Nerd Font glyph instead of an icon
  { "showApps": true }                    the shell app menu
  { "trash": true }                       open the trash in the file manager
  { "spacer": true }                      divider rule
  { "when": "<cmd>" }                     show only while the command exits 0
EOF
      ;;
    *) die "unknown subcommand '$1' (try --help)" ;;
  esac
else
  cat <<'EOF'
usage: omarchy-dock-config <subcommand> ...

Programmatic editor for the animated.dock plugin entry in shell.json.
Run with --help for the full command list and config reference.
EOF
fi